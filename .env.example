# Copia este archivo a ".env" y completa tus propias credenciales.
# NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).

# Banco Central de Chile - Base de Datos Estadisticos (BDE)
# Registro gratuito en: https://si3.bcentral.cl
# Metodo moderno (recomendado): token unico.
BCCH_API_TOKEN=

# Metodo legado (usar solo si no tienes token): usuario y contrasena de tu cuenta BDE.
BCCH_USUARIO=
BCCH_PASSWORD=

# CMF Bancos API (ex SBIF) - indicadores financieros (dolar, UF, UTM, etc.)
# Solicitud de apikey gratuita en: https://api.cmfchile.cl/que-es-api.html
CMF_API_KEY=

# INE (Instituto Nacional de Estadisticas) - SDMX (sdmx.ine.gob.cl)
# No requiere credenciales: es una API publica sin autenticacion.
